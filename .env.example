# LLM & External API Keys
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Configurations
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RERANKER_MODEL=cohere/rerank-v3.5
RERANKER_TIMEOUT=8

# CORS (pisahkan dengan koma). Default: localhost + HF Space.
# Kosongkan CORS_ALLOW_ORIGINS untuk memakai daftar default.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(netlify\.app|hf\.space)$
CORS_ALLOW_CREDENTIALS=false

# LangSmith Tracing
LANGSMITH_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chilicare
